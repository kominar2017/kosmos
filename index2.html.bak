<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Полёт</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body {
    width: 100%; height: 100%; overflow: hidden;
    background: #000;
    font-family: 'Space Mono', 'JetBrains Mono', monospace;
    color: #fff; cursor: crosshair; user-select: none;
    -webkit-font-smoothing: antialiased;
  }
  #space { position: fixed; inset: 0; z-index: 1; }
  #earth3d {
    position: fixed; left: 0; top: 0;
    width: 100%; height: 100vh;
    z-index: 2; pointer-events: none;
  }
  #ui-canvas {
    position: fixed; left: 0; top: 0;
    width: 100%; height: 100vh;
    z-index: 4; pointer-events: none;
  }
  .ui { position: fixed; inset: 0; z-index: 5; pointer-events: none; }
  #counter {
    position: absolute; bottom: 130px; left: 50%;
    transform: translateX(-50%); text-align: center;
  }
  #distance {
    font-size: 52px; font-weight: 400; letter-spacing: 3px;
    color: #e8f4ff;
    text-shadow: 0 0 30px rgba(140, 200, 255, 0.5);
    transition: color 0.4s ease, text-shadow 0.4s ease;
    font-variant-numeric: tabular-nums;
  }
  #unit {
    font-size: 10px; opacity: 0.35; margin-top: 10px;
    letter-spacing: 6px; color: #a8c4e0;
    transition: color 0.4s ease, opacity 0.4s ease;
  }
  #counter.boost #distance {
    color: #a8dcff;
    text-shadow: 0 0 40px rgba(120, 200, 255, 0.9),
                 0 0 80px rgba(80, 160, 255, 0.5);
  }
  #counter.boost #unit { color: #7cc4ff; opacity: 0.6; }
  #milestone {
    position: absolute; bottom: 100px; left: 50%;
    transform: translateX(-50%);
    font-size: 11px; letter-spacing: 1px;
    color: rgba(180, 210, 255, 0.7);
    text-align: center; opacity: 0;
    transition: opacity 1.5s ease;
    pointer-events: none; max-width: 620px; font-weight: 300;
  }
  #milestone.show { opacity: 1; }
  #hint {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-size: 12px; letter-spacing: 8px;
    color: rgba(255, 255, 255, 0.2);
    font-weight: 300;
    animation: pulse 3s infinite ease-in-out;
    transition: opacity 1s ease;
    pointer-events: none;
  }
  @keyframes pulse { 0%, 100% { opacity: 0.12; } 50% { opacity: 0.4; } }
  #donate {
    position: absolute; bottom: 24px; right: 24px;
    padding: 8px 14px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    color: rgba(255, 255, 255, 0.25);
    font-family: inherit; font-size: 10px;
    letter-spacing: 2px; cursor: pointer;
    pointer-events: auto;
    transition: all 0.4s ease; opacity: 0.4;
  }
  #donate:hover {
    color: #ffb8c8;
    border-color: rgba(255, 150, 180, 0.4);
    opacity: 1;
    box-shadow: 0 0 20px rgba(255, 150, 180, 0.15);
  }
  #reviewBtn {
    position: absolute; bottom: 24px; left: 24px;
    padding: 8px 14px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    color: rgba(255, 255, 255, 0.35);
    font-family: inherit; font-size: 10px;
    letter-spacing: 2px; cursor: pointer;
    pointer-events: auto;
    transition: all 0.4s ease; opacity: 0.5;
  }
  #reviewBtn:hover {
    color: #a8d8ff;
    border-color: rgba(140, 200, 255, 0.5);
    opacity: 1;
    box-shadow: 0 0 20px rgba(140, 200, 255, 0.15);
  }
  #reviewPanel {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    padding: 28px 40px 32px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9), rgba(0, 0, 0, 0.6) 60%, transparent);
    display: flex; flex-direction: column; gap: 14px;
    transform: translateY(120%);
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: auto;
    z-index: 100;
  }
  #reviewPanel.show { transform: translateY(0); }
  #reviewKmLabel {
    text-align: center;
    font-size: 11px;
    letter-spacing: 3px;
    color: rgba(180, 210, 255, 0.6);
    font-variant-numeric: tabular-nums;
  }
  .review-controls { display: flex; align-items: center; gap: 20px; }
  #reviewPlay, #reviewClose {
    width: 42px; height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(140, 200, 255, 0.35);
    background: rgba(0, 0, 0, 0.5);
    color: #a8d8ff;
    font-family: inherit;
    font-size: 14px;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.3s ease;
    display: flex; align-items: center; justify-content: center;
  }
  #reviewPlay:hover, #reviewClose:hover {
    background: rgba(140, 200, 255, 0.15);
    color: #fff;
    border-color: rgba(160, 220, 255, 0.7);
    box-shadow: 0 0 20px rgba(140, 200, 255, 0.3);
  }
  #reviewSlider {
    flex: 1;
    height: 4px;
    -webkit-appearance: none;
    appearance: none;
    background: rgba(140, 180, 240, 0.15);
    border-radius: 2px;
    outline: none;
    cursor: pointer;
  }
  #reviewSlider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px; height: 16px;
    border-radius: 50%;
    background: #a8d8ff;
    box-shadow: 0 0 14px rgba(140, 200, 255, 0.9), 0 0 4px rgba(160, 220, 255, 1);
    cursor: pointer;
  }
  #reviewSlider::-moz-range-thumb {
    width: 16px; height: 16px;
    border-radius: 50%;
    background: #a8d8ff;
    border: none;
    box-shadow: 0 0 14px rgba(140, 200, 255, 0.9);
    cursor: pointer;
  }
  #jumpBox {
    position: fixed; top: 20px; right: 20px;
    display: flex; gap: 8px; z-index: 9999;
  }
  #jumpInput {
    width: 170px; padding: 10px 14px;
    background: rgba(0, 0, 0, 0.75);
    border: 1px solid rgba(140, 200, 255, 0.5);
    border-radius: 6px; color: #fff;
    font-family: inherit; font-size: 12px;
    outline: none; letter-spacing: 1px;
  }
  #jumpInput::placeholder { color: rgba(255, 255, 255, 0.35); }
  #jumpInput:focus {
    border-color: rgba(160, 220, 255, 0.95);
    background: rgba(0, 0, 0, 0.9);
    box-shadow: 0 0 20px rgba(140, 200, 255, 0.3);
  }
  #jumpBtn {
    padding: 10px 18px;
    background: rgba(0, 0, 0, 0.75);
    border: 1px solid rgba(140, 200, 255, 0.5);
    border-radius: 6px;
    color: #a8d8ff;
    font-family: inherit; font-size: 14px;
    cursor: pointer; transition: all 0.3s ease;
  }
  #jumpBtn:hover {
    background: rgba(140, 200, 255, 0.15);
    color: #fff;
    border-color: rgba(160, 220, 255, 0.9);
  }
</style>
</head>
<body>

<canvas id="space"></canvas>
<canvas id="earth3d"></canvas>
<canvas id="ui-canvas"></canvas>

<div class="ui">
  <div id="counter">
    <div id="distance">0</div>
    <div id="unit">КМ ОТ ЗЕМЛИ</div>
  </div>
  <div id="milestone"></div>
  <div id="hint">КЛИКНИ</div>
  <button id="donate">ПОДДЕРЖАТЬ</button>
  <button id="reviewBtn">🎬 СМОТРЕТЬ ПОЛЁТ</button>
</div>

<div id="reviewPanel">
  <div id="reviewKmLabel">1 км</div>
  <div class="review-controls">
    <button id="reviewPlay">▶</button>
    <input type="range" id="reviewSlider" min="0" max="1000" value="0" step="1">
    <button id="reviewClose">✕</button>
  </div>
</div>

<div id="jumpBox">
  <input type="text" id="jumpInput" placeholder="введи км" />
  <button id="jumpBtn">→</button>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
/* =========================================================
   THREE.JS — ЗЕМЛЯ + АТМОСФЕРА + ОБЛАКА + НОЧЬ
   ========================================================= */
const earthCanvas = document.getElementById('earth3d');

const earthRenderer = new THREE.WebGLRenderer({
  canvas: earthCanvas,
  alpha: true,
  antialias: true
});
earthRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
earthRenderer.setClearColor(0x000000, 0);
earthRenderer.outputEncoding = THREE.sRGBEncoding;
earthRenderer.toneMapping = THREE.ACESFilmicToneMapping;
earthRenderer.toneMappingExposure = 1.0;

const earthScene = new THREE.Scene();
const earthCamera = new THREE.PerspectiveCamera(55, 1, 0.1, 20000);
earthCamera.position.set(0, 0, 3);
earthCamera.lookAt(0, 0, 0);

const earthUniforms = {
  dayTexture:   { value: null },
  nightTexture: { value: null },
  sunDirection: { value: new THREE.Vector3(5, 3, 2).normalize() },
  hazeColor:    { value: new THREE.Color(0x6aaae8) },
  termColor:    { value: new THREE.Color(0xaad4ff) },
  termWidth:    { value: 0.15 },
  hazeStrength: { value: 0.10 },
  fresnelPower: { value: 3.5 },
  fresnelColor: { value: new THREE.Color(0x8fc4ff) },
  nightLights:  { value: 0.0 },
  time:         { value: 0.0 }
};

const earthMat = new THREE.ShaderMaterial({
  uniforms: earthUniforms,
  vertexShader: `
    varying vec2 vUv;
    varying vec3 vNormal;
    varying vec3 vViewDir;
    varying vec3 vPosition;
    void main() {
      vUv = uv;
      vNormal = normalize(normalMatrix * normal);
      vec4 worldPos = modelMatrix * vec4(position, 1.0);
      vPosition = worldPos.xyz;
      vViewDir = normalize(cameraPosition - worldPos.xyz);
      gl_Position = projectionMatrix * viewMatrix * worldPos;
    }
  `,
  fragmentShader: `
    uniform sampler2D dayTexture;
    uniform sampler2D nightTexture;
    uniform vec3 sunDirection;
    uniform vec3 hazeColor;
    uniform vec3 termColor;
    uniform float termWidth;
    uniform float hazeStrength;
    uniform float fresnelPower;
    uniform vec3 fresnelColor;
    uniform float nightLights;
    uniform float time;
    varying vec2 vUv;
    varying vec3 vNormal;
    varying vec3 vViewDir;
    varying vec3 vPosition;

    void main() {
      vec3 base = texture2D(dayTexture, vUv).rgb;
      if (base.r + base.g + base.b < 0.01) {
        base = vec3(0.1, 0.35, 0.6);
      }

      float sunDot = dot(vNormal, sunDirection);
      float lit = smoothstep(-0.05, 0.25, sunDot);

      float termDist = abs(sunDot);
      float terminator = 1.0 - smoothstep(0.0, termWidth, termDist);
      terminator = pow(terminator, 2.0) * 0.6;

      vec3 dayColor = base * (0.6 + 0.7 * lit);
      vec3 nightBase = base * 0.06 + vec3(0.005, 0.008, 0.02);

      vec3 cityRaw = texture2D(nightTexture, vUv).rgb;

      vec2 texel = vec2(1.0 / 2048.0, 1.0 / 1024.0);
      vec3 glow = vec3(0.0);
      glow += texture2D(nightTexture, vUv).rgb * 1.0;
      glow += texture2D(nightTexture, vUv + vec2( texel.x * 2.0, 0.0)).rgb * 0.7;
      glow += texture2D(nightTexture, vUv + vec2(-texel.x * 2.0, 0.0)).rgb * 0.7;
      glow += texture2D(nightTexture, vUv + vec2( 0.0,  texel.y * 2.0)).rgb * 0.7;
      glow += texture2D(nightTexture, vUv + vec2( 0.0, -texel.y * 2.0)).rgb * 0.7;
      glow += texture2D(nightTexture, vUv + vec2( texel.x * 4.0,  texel.y * 4.0)).rgb * 0.4;
      glow += texture2D(nightTexture, vUv + vec2(-texel.x * 4.0, -texel.y * 4.0)).rgb * 0.4;
      glow += texture2D(nightTexture, vUv + vec2( texel.x * 4.0, -texel.y * 4.0)).rgb * 0.4;
      glow += texture2D(nightTexture, vUv + vec2(-texel.x * 4.0,  texel.y * 4.0)).rgb * 0.4;
      glow /= 5.4;

      vec3 cityCenters = cityRaw * cityRaw * 4.0;
      vec3 cityFinal = glow * 1.1 + cityCenters * 0.7;
      cityFinal *= vec3(1.2, 0.95, 0.6);

      float nightMask = 1.0 - smoothstep(-0.05, 0.15, sunDot);
      nightBase += cityFinal * nightMask * nightLights;

      vec3 color = mix(nightBase, dayColor, lit);
      color = mix(color, hazeColor, hazeStrength);

      float fres = pow(1.0 - max(dot(vNormal, vViewDir), 0.0), fresnelPower);
      color += fresnelColor * fres * 0.45 * lit;

      color += termColor * terminator;

      gl_FragColor = vec4(color, 1.0);
    }
  `
});

const earthGeo = new THREE.SphereGeometry(1, 128, 128);
const earthMesh = new THREE.Mesh(earthGeo, earthMat);
earthScene.add(earthMesh);

const cloudUniforms = {
  sunDirection: { value: new THREE.Vector3(5, 3, 2).normalize() },
  time:         { value: 0.0 },
  opacity:      { value: 0.55 }
};

const cloudMat = new THREE.ShaderMaterial({
  uniforms: cloudUniforms,
  vertexShader: `
    varying vec3 vNormal;
    varying vec3 vViewDir;
    varying vec3 vModelPos;
    void main() {
      vModelPos = normalize(position);
      vNormal = normalize(normalMatrix * normal);
      vec4 worldPos = modelMatrix * vec4(position, 1.0);
      vViewDir = normalize(cameraPosition - worldPos.xyz);
      gl_Position = projectionMatrix * viewMatrix * worldPos;
    }
  `,
  fragmentShader: `
    uniform vec3 sunDirection;
    uniform float time;
    uniform float opacity;
    varying vec3 vNormal;
    varying vec3 vViewDir;
    varying vec3 vModelPos;

    float hash31(vec3 p) {
      p = fract(p * vec3(0.1031, 0.1030, 0.0973));
      p += dot(p, p.yzx + 33.33);
      return fract((p.x + p.y) * p.z);
    }
    float noise3(vec3 p) {
      vec3 i = floor(p);
      vec3 f = fract(p);
      f = f * f * (3.0 - 2.0 * f);
      float n000 = hash31(i + vec3(0.0, 0.0, 0.0));
      float n100 = hash31(i + vec3(1.0, 0.0, 0.0));
      float n010 = hash31(i + vec3(0.0, 1.0, 0.0));
      float n110 = hash31(i + vec3(1.0, 1.0, 0.0));
      float n001 = hash31(i + vec3(0.0, 0.0, 1.0));
      float n101 = hash31(i + vec3(1.0, 0.0, 1.0));
      float n011 = hash31(i + vec3(0.0, 1.0, 1.0));
      float n111 = hash31(i + vec3(1.0, 1.0, 1.0));
      float nx00 = mix(n000, n100, f.x);
      float nx10 = mix(n010, n110, f.x);
      float nx01 = mix(n001, n101, f.x);
      float nx11 = mix(n011, n111, f.x);
      float nxy0 = mix(nx00, nx10, f.y);
      float nxy1 = mix(nx01, nx11, f.y);
      return mix(nxy0, nxy1, f.z);
    }
    float fbm3(vec3 p) {
      float v = 0.0;
      float a = 0.5;
      for (int i = 0; i < 6; i++) {
        v += a * noise3(p);
        p *= 2.02;
        a *= 0.5;
      }
      return v;
    }

    void main() {
      vec3 p = vModelPos + vec3(time * 0.005, 0.0, time * 0.003);

      float c1 = fbm3(p * 2.2);
      float c2 = fbm3(p * 5.5);
      float c3 = fbm3(p * 12.0);
      float clouds = c1 * 0.55 + c2 * 0.30 + c3 * 0.15;

      clouds = smoothstep(0.45, 0.80, clouds);

      float lat = abs(vModelPos.y);
      clouds *= 1.0 - smoothstep(0.8, 1.0, lat) * 0.55;

      vec3 worldNormal = normalize(vNormal);
      float sunDot = dot(worldNormal, sunDirection);
      float lit = smoothstep(-0.15, 0.25, sunDot);

      vec3 cloudCol = mix(vec3(0.55, 0.6, 0.72), vec3(1.0, 0.98, 0.95), lit);

      float a = clouds * opacity * 0.6 * (0.15 + 0.85 * lit);
      gl_FragColor = vec4(cloudCol, a);
    }
  `,
  transparent: true,
  depthWrite: false
});

const cloudMesh = new THREE.Mesh(new THREE.SphereGeometry(1.012, 128, 128), cloudMat);
earthScene.add(cloudMesh);

/* ---------------------------------------------------------
   ЗАГРУЗКА ТЕКСТУР
   --------------------------------------------------------- */
const texLoader = new THREE.TextureLoader();

texLoader.load(
  'textures/earth.jpg',
  (tex) => {
    tex.anisotropy = earthRenderer.capabilities.getMaxAnisotropy();
    tex.encoding = THREE.sRGBEncoding;
    earthUniforms.dayTexture.value = tex;
    console.log('[THREE] Земля (день) загружена');
  },
  undefined,
  () => { console.warn('[THREE] earth.jpg не найден'); }
);

texLoader.load(
  'textures/night.jpg',
  (tex) => {
    tex.anisotropy = earthRenderer.capabilities.getMaxAnisotropy();
    tex.encoding = THREE.sRGBEncoding;
    earthUniforms.nightTexture.value = tex;
    console.log('[THREE] Земля (ночь) загружена');
  },
  undefined,
  () => { console.warn('[THREE] night.jpg не найден'); }
);

const sunLight = new THREE.DirectionalLight(0xfff0d8, 1.0);
sunLight.position.set(5, 3, 2);
earthScene.add(sunLight);

const ambient = new THREE.AmbientLight(0x2a3a5a, 0.3);
earthScene.add(ambient);

const atmoAMat = new THREE.ShaderMaterial({
  uniforms: {
    color: { value: new THREE.Color(0x9ad2ff) },
    intensity: { value: 0.55 }
  },
  vertexShader: `
    varying vec3 vNormal;
    varying vec3 vPosition;
    void main() {
      vNormal = normalize(normalMatrix * normal);
      vPosition = position;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
    }
  `,
  fragmentShader: `
    uniform vec3 color;
    uniform float intensity;
    varying vec3 vNormal;
    varying vec3 vPosition;
    void main() {
      vec3 viewDir = normalize(cameraPosition - vPosition);
      float facing = dot(vNormal, viewDir);
      float rim = pow(1.0 - abs(facing), 2.5);
      gl_FragColor = vec4(color, rim * intensity);
    }
  `,
  transparent: true,
  blending: THREE.AdditiveBlending,
  side: THREE.BackSide,
  depthWrite: false
});
const atmoA = new THREE.Mesh(new THREE.SphereGeometry(1.06, 64, 64), atmoAMat);
earthScene.add(atmoA);

const atmoBMat = new THREE.ShaderMaterial({
  uniforms: {
    color: { value: new THREE.Color(0x5aa0f0) },
    intensity: { value: 0.35 }
  },
  vertexShader: `
    varying vec3 vNormal;
    varying vec3 vPosition;
    void main() {
      vNormal = normalize(normalMatrix * normal);
      vPosition = position;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
    }
  `,
  fragmentShader: `
    uniform vec3 color;
    uniform float intensity;
    varying vec3 vNormal;
    varying vec3 vPosition;
    void main() {
      vec3 viewDir = normalize(cameraPosition - vPosition);
      float facing = dot(vNormal, viewDir);
      float rim = pow(1.0 - abs(facing), 3.5);
      gl_FragColor = vec4(color, rim * intensity);
    }
  `,
  transparent: true,
  blending: THREE.AdditiveBlending,
  side: THREE.BackSide,
  depthWrite: false
});
const atmoB = new THREE.Mesh(new THREE.SphereGeometry(1.15, 64, 64), atmoBMat);
earthScene.add(atmoB);

const atmoCMat = new THREE.ShaderMaterial({
  uniforms: {
    color: { value: new THREE.Color(0x4682dc) },
    intensity: { value: 0.15 }
  },
  vertexShader: `
    varying vec3 vNormal;
    varying vec3 vPosition;
    void main() {
      vNormal = normalize(normalMatrix * normal);
      vPosition = position;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
    }
  `,
  fragmentShader: `
    uniform vec3 color;
    uniform float intensity;
    varying vec3 vNormal;
    varying vec3 vPosition;
    void main() {
      vec3 viewDir = normalize(cameraPosition - vPosition);
      float facing = dot(vNormal, viewDir);
      float rim = pow(1.0 - abs(facing), 5.0);
      gl_FragColor = vec4(color, rim * intensity);
    }
  `,
  transparent: true,
  blending: THREE.AdditiveBlending,
  side: THREE.BackSide,
  depthWrite: false
});
const atmoC = new THREE.Mesh(new THREE.SphereGeometry(1.28, 64, 64), atmoCMat);
earthScene.add(atmoC);

const limbMat = new THREE.ShaderMaterial({
  uniforms: {
    color: { value: new THREE.Color(0xaad8ff) },
    intensity: { value: 0.85 }
  },
  vertexShader: `
    varying vec3 vNormal;
    varying vec3 vPosition;
    void main() {
      vNormal = normalize(normalMatrix * normal);
      vPosition = position;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
    }
  `,
  fragmentShader: `
    uniform vec3 color;
    uniform float intensity;
    varying vec3 vNormal;
    varying vec3 vPosition;
    void main() {
      vec3 viewDir = normalize(cameraPosition - vPosition);
      float facing = dot(vNormal, viewDir);
      float rim = pow(1.0 - abs(facing), 8.0);
      gl_FragColor = vec4(color, rim * intensity);
    }
  `,
  transparent: true,
  blending: THREE.AdditiveBlending,
  side: THREE.BackSide,
  depthWrite: false
});
const limb = new THREE.Mesh(new THREE.SphereGeometry(1.02, 64, 64), limbMat);
earthScene.add(limb);

function resizeEarth() {
  const w = window.innerWidth;
  const h = window.innerHeight;
  earthRenderer.setSize(w, h, false);
  earthCamera.aspect = w / h;
  earthCamera.updateProjectionMatrix();
}
resizeEarth();
window.addEventListener('resize', resizeEarth);

function updateEarth(km, dt) {
  dt = dt || 0.016;

  const tAtmo = Math.min(1, km / 60);

  const camY = 1.4 - tAtmo * 0.9;
  earthCamera.position.set(0, camY, 3.2);
  earthCamera.lookAt(0, 0.15, 0);

  // === МАСШТАБ ЗЕМЛИ ===
  let scale;
  let earthReveal;

  if (km < 180) {
    scale = 3.2;
    earthReveal = 0;
  } else if (km < 400) {
    const t = (km - 180) / 220;
    scale = 3.2 - t * 1.4;
    earthReveal = Math.min(1, t * 3);
  } else {
    // scale = 720 / km  →  на 400 = 1.8, на 60000 = 0.012
    scale = 720 / km;
    earthReveal = 1;
  }

  // === После 60000 км — Three.js отключаем, Земля станет 2D-точкой ===
  const use3DEarth = km < 60000;
  const showEarth = use3DEarth && earthReveal > 0.01 && scale > 0.0004;

  const yPosScaled = -0.75 * Math.min(scale, 1.5);

  earthMesh.scale.setScalar(scale);
  earthMesh.position.set(0, yPosScaled, 0);
  earthMesh.rotation.y += 0.0008 * (dt / 0.016);
  earthMesh.rotation.z = 0.41;

  cloudMesh.scale.setScalar(scale);
  cloudMesh.position.set(0, yPosScaled, 0);
  cloudMesh.rotation.y += 0.0012 * (dt / 0.016);
  cloudMesh.rotation.z = 0.41;
  cloudUniforms.sunDirection.value.copy(earthUniforms.sunDirection.value);
  cloudUniforms.time.value = globalTime;

  const sunAngle = globalTime * 0.05;
  earthUniforms.sunDirection.value.set(
    Math.cos(sunAngle) * 0.7 + 0.3,
    0.4,
    Math.sin(sunAngle) * 0.7 + 0.3
  ).normalize();

  const lightsAmount = Math.min(1, Math.max(0, (km - 180) / 220));
  earthUniforms.nightLights.value = lightsAmount;
  earthUniforms.time.value = globalTime;

  const inAtmo = Math.max(0, 1 - km / 200);
  const atmoFade = Math.min(1, Math.max(0, (km - 180) / 100)) * Math.max(0, 1 - km / 40000);

  atmoA.scale.setScalar(scale);
  atmoA.position.set(0, yPosScaled, 0);
  atmoA.rotation.z = 0.41;
  atmoAMat.uniforms.intensity.value = (0.55 + inAtmo * 0.55) * atmoFade;

  atmoB.scale.setScalar(scale);
  atmoB.position.set(0, yPosScaled, 0);
  atmoB.rotation.z = 0.41;
  atmoBMat.uniforms.intensity.value = (0.35 + inAtmo * 0.45) * atmoFade;

  atmoC.scale.setScalar(scale);
  atmoC.position.set(0, yPosScaled, 0);
  atmoC.rotation.z = 0.41;
  atmoCMat.uniforms.intensity.value = 0.15 * atmoFade;

  limb.scale.setScalar(scale);
  limb.position.set(0, yPosScaled, 0);
  limb.rotation.z = 0.41;
  limbMat.uniforms.intensity.value = (0.85 + inAtmo * 0.4) * atmoFade;

  const cloudFade = Math.max(0, 1 - km / 20000);
  cloudUniforms.opacity.value = 0.55 * cloudFade;

  earthMesh.visible = showEarth;
  cloudMesh.visible = showEarth && cloudFade > 0.02;
  atmoA.visible = showEarth;
  atmoB.visible = showEarth;
  atmoC.visible = showEarth;
  limb.visible = showEarth;

  if (showEarth) {
    earthCanvas.style.opacity = '1';
    earthRenderer.render(earthScene, earthCamera);
  } else {
    earthCanvas.style.opacity = '0';
  }
}

